            </button>
            <a href="#hook-quizzes" class="bg-slate-800/80 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold px-4 py-2.5 rounded-xl transition text-xs sm:text-sm flex items-center gap-2">
              Jump to Hook Quizzes <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
            </a>
          </div>
        </div>
