  <!-- ================= JAVASCRIPT: LOGIC & GAMIFICATION ================= -->
  <script>
    // State variables
    let currentXp = 0;
    let answeredQuestions = new Set();
    let currentSlide = 0;

    // Slide Deck Content
    const slides = [
      {
        tag: "SLIDE 1: INTRODUCTION",
        title: "Sarawak Hydroelectric Energy: Clean Power vs. Borneo Rivers",
        desc: "An exploration into the mechanics, decarbonization dividends, and indigenous community dilemmas of Southeast Asia's hydropower giant.",
        bullets: ["Location: Sarawak, Malaysian Borneo", "Key Rivers: Rajang, Balui, Murum, Batang Ai", "Focus: Physics, Climate Action, and Human Trade-offs"]
      },
      {
        tag: "SLIDE 2: THE PHYSICS",
        title: "How Moving Water Becomes Electricity",
        desc: "Energy cannot be created; it is converted from gravity to alternating current.",
        bullets: ["Potential Energy: High altitude reservoir storage", "Kinetic Energy: Water plunges through steel penstocks", "Electromagnetic Generation: Rotors spin at 50 revolutions per second inside stators"]
      },
      {
        tag: "SLIDE 3: THE CLIMATE DIVIDEND",
        title: "Decarbonizing the Sarawak Grid",
        desc: "Replacing fossil fuels with hydro baseload transformed Sarawak's emissions curve.",
        bullets: ["73% reduction in grid carbon intensity since 2010", "Powers clean industrial hubs in Samalaju (aluminum & solar polysilicon)", "Supplies clean energy to West Kalimantan (Indonesia)"]
      },
      {
        tag: "SLIDE 4: THE HIDDEN CONCERN",
        title: "Tropical Methane & Reservoir Inundation",
        desc: "Why tropical dams can emit greenhouse gases during initial years.",
        bullets: ["Flooding dense jungle drowns millions of tons of organic biomass", "Underwater anaerobic bacteria decay leaves into Methane (CH₄)", "Methane has ~28x higher warming potential than CO₂ over 100 years"]
      },
      {
        tag: "SLIDE 5: SOCIAL LANDSCAPE",
        title: "Indigenous Resettlement: Kenyah, Kayan & Penan",
        desc: "The human dimension of mega-infrastructure.",
        bullets: ["Over 10,000 natives relocated from Balui river to Sungai Asap", "Loss of ancestral burial grounds and traditional hunting rivers", "Necessity for Free, Prior, and Informed Consent (FPIC)"]
      },
      {
        tag: "SLIDE 6: LOCAL CASE STUDY",
        title: "Bakun Dam & Murum Dam at a Glance",
        desc: "Engineering marvels with deep socio-ecological lessons.",
        bullets: ["Bakun: 2,400 MW capacity, reservoir size of Singapore (~695 km²)", "Murum: 944 MW capacity, engineered with IHA sustainability protocols", "Baleh Dam: Next frontier in run-of-river optimization"]
      },
      {
        tag: "SLIDE 7: THE MODERN SOLUTION",
        title: "Hybrid Floating Solar & Micro-Hydro",
        desc: "How Sarawak is innovating without flooding more native land.",
        bullets: ["Batang Ai 50 MW Floating Solar: Zero land clearing required", "Water cools panels, boosting efficiency by up to 10%", "Decentralized micro-hydro in remote highlands (Bario & Long Lamai)"]
      },
      {
        tag: "SLIDE 8: CIVIC CALL TO ACTION",
        title: "What Can We Do? Policy & Informed Advocacy",
        desc: "Meaningful climate action requires nuanced decision making.",
        bullets: ["Advocate for floating solar hybrid retrofits on existing dams", "Support indigenous customary land recognition (NCR)", "Submit your voice to our policy reflection registry"]
      }
    ];

    // Initialization
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      renderSlide();
      calculateSimulator();
      document.getElementById('certDate').innerText = new Date().toLocaleDateString('en-MY', { month: 'short', year: 'numeric' });
    });

    // Sound / Confetti XP Reward Helper
    function addXp(points, reason) {
      currentXp = Math.min(500, currentXp + points);
      document.getElementById('userXp').innerText = currentXp;

      if (window.confetti) {
        confetti({
          particleCount: 40,
          spread: 60,
          origin: { y: 0.8 }
        });
      }
    }

    function awardBonusXP(pts, reason) {
      if (!answeredQuestions.has(reason)) {
        answeredQuestions.add(reason);
        addXp(pts, reason);
      }
    }

    // Tab Switching Navigation
    function switchTab(tabId) {
      document.querySelectorAll('.page-view').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-tab').forEach(btn => {
        btn.classList.remove('text-emerald-400', 'bg-slate-800');
        btn.classList.add('text-slate-300');
      });

      const target = document.getElementById(tabId);
      if (target) {
        target.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      const activeNav = document.getElementById(`nav-${tabId}`);
      if (activeNav) {
        activeNav.classList.add('text-emerald-400', 'bg-slate-800');
        activeNav.classList.remove('text-slate-300');
      }
      lucide.createIcons();
    }

    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      menu.classList.toggle('hidden');
    }

    // Hook Quiz Logic
    function answerHook(qNum, choice) {
      const respBox = document.getElementById(`q${qNum}-resp`);
      respBox.classList.remove('hidden');

      if (qNum === 1) {
        if (choice === 'B') {
          respBox.className = "mt-4 p-3 rounded-xl text-xs bg-emerald-950/80 border border-emerald-600 text-emerald-300";
          respBox.innerHTML = "<strong>✓ Correct! (+50 XP)</strong> Water plunges down the penstock, converting gravitational head into kinetic force that spins the turbine shaft.";
          if (!answeredQuestions.has('hook1')) { answeredQuestions.add('hook1'); addXp(50); }
        } else {
          respBox.className = "mt-4 p-3 rounded-xl text-xs bg-rose-950/80 border border-rose-700 text-rose-300";
          respBox.innerHTML = "<strong>✗ Not quite!</strong> Hydro uses no steam or chemicals. It is purely mechanical kinetic energy turning an electromagnetic rotor.";
        }
      } else if (qNum === 2) {
        if (choice === 'A') {
          respBox.className = "mt-4 p-3 rounded-xl text-xs bg-emerald-950/80 border border-emerald-600 text-emerald-300";
          respBox.innerHTML = "<strong>✓ Exactly right! (+50 XP)</strong> Submerged tropical forests decompose anaerobically, bubbling out methane (CH₄) in the first 5-10 years.";
          if (!answeredQuestions.has('hook2')) { answeredQuestions.add('hook2'); addXp(50); }
        } else {
          respBox.className = "mt-4 p-3 rounded-xl text-xs bg-rose-950/80 border border-rose-700 text-rose-300";
          respBox.innerHTML = "<strong>✗ Incorrect.</strong> The culprit is decaying submerged jungle vegetation creating biogenic methane under water.";
        }
      }
    }

    function votePoll(choice, pct) {
      document.getElementById('poll-results').classList.remove('hidden');
      if (!answeredQuestions.has('hook3')) {
        answeredQuestions.add('hook3');
        addXp(50);
      }
    }

    // Interactive Dam Simulator Math
    function calculateSimulator() {
      const head = parseFloat(document.getElementById('headSlider').value);
      const flow = parseFloat(document.getElementById('flowSlider').value);
      const eff = parseFloat(document.getElementById('effSlider').value) / 100;

      document.getElementById('headVal').innerText = `${head} meters`;
      document.getElementById('flowVal').innerText = `${flow} m³/s`;
      document.getElementById('effVal').innerText = `${Math.round(eff * 100)}%`;

      // Formula: P (Watts) = rho (1000) * g (9.81) * Q * H * eta
      const powerWatts = 1000 * 9.81 * flow * head * eff;
      const powerMW = Math.round(powerWatts / 1000000);
      const homes = (powerMW * 1250).toLocaleString();

      document.getElementById('simPower').innerText = `${powerMW.toLocaleString()} MW`;
      document.getElementById('homesPowered').innerText = `Powers ~${homes} Bornean Homes`;
      
      const pctMax = Math.min(100, Math.round((powerMW / 3800) * 100));
      document.getElementById('powerBar').style.width = `${pctMax}%`;

      // Ecological Risk calculation based on Head & Flow
      const riskScore = (head * 0.5) + (flow * 0.05);
      const ecoDesc = document.getElementById('ecoDescription');
      const ecoRisk = document.getElementById('simEcoRisk');
      const ecoBar = document.getElementById('ecoBar');

      if (head < 60) {
        ecoRisk.innerText = "Low Impact (Run-of-River)";
        ecoRisk.className = "text-2xl sm:text-3xl font-extrabold text-emerald-400 my-2 font-heading";
        ecoDesc.innerText = "Minimal reservoir flooding; preserves natural riverbanks.";
        ecoBar.className = "bg-emerald-400 h-2 rounded-full transition-all";
        ecoBar.style.width = "25%";
      } else if (head < 140) {
        ecoRisk.innerText = "Moderate Inundation";
        ecoRisk.className = "text-2xl sm:text-3xl font-extrabold text-amber-400 my-2 font-heading";
        ecoDesc.innerText = "Floods ~150-300 km²; moderate fish migration impacts.";
        ecoBar.className = "bg-amber-400 h-2 rounded-full transition-all";
        ecoBar.style.width = "60%";
      } else {
        ecoRisk.innerText = "Mega-Dam Inundation";
        ecoRisk.className = "text-2xl sm:text-3xl font-extrabold text-rose-400 my-2 font-heading";
        ecoDesc.innerText = "Floods 400-700 km² of dense tropical forest; indigenous relocation required.";
        ecoBar.className = "bg-rose-400 h-2 rounded-full transition-all";
        ecoBar.style.width = "95%";
      }
    }

    // Trivia Card Reveal
    function revealFact(el) {
      el.classList.add('border-emerald-400', 'bg-slate-800');
      addXp(15);
    }

    // Mastery Question Checker (Section 6)
    function checkMastery(section, option, isCorrect) {
      const respBox = document.getElementById(`mastery-resp-${section}`);
      respBox.classList.remove('hidden');

      if (isCorrect) {
        respBox.className = "p-3 rounded-xl text-xs bg-emerald-950 border border-emerald-600 text-emerald-300";
        respBox.innerHTML = "<strong>✓ Mastered! (+50 XP)</strong> Exactly. Balancing low-carbon energy with ecological integrity is the cornerstone of sustainable climate action.";
        if (!answeredQuestions.has(`mastery_${section}`)) {
          answeredQuestions.add(`mastery_${section}`);
          addXp(50);
        }
      } else {
        respBox.className = "p-3 rounded-xl text-xs bg-rose-950 border border-rose-700 text-rose-300";
        respBox.innerHTML = "<strong>✗ Review the concept:</strong> Consider the profound human and ecological stakes of tropical river alteration.";
      }
    }

    // Reflection Submission & Certificate Unlock
    const reflectionForm = document.getElementById('civicActionForm');
    reflectionForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('submitActionBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Submitting to thaddeusphanna@gmail.com...`;
      lucide.createIcons();

      const name = document.getElementById('authorName').value;
      const email = document.getElementById('authorEmail').value;
      const role = document.getElementById('authorRole').value;
      const reflection = document.getElementById('reflectionText').value;

      // Update certificate live
      document.getElementById('certName').innerText = name || "Borneo Eco-Steward";

      const payload = {
        name: name,
        email: email,
        stance: role,
        reflection: reflection,
        _subject: `New Sarawak Hydro Reflection from ${name}`,
        _to: "thaddeusphanna@gmail.com"
      };

      try {
        await fetch("https://formsubmit.co/ajax/thaddeusphanna@gmail.com", {
          method: "POST",
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err) {
        console.log("Transmission handled gracefully:", err);
      }

      document.getElementById('submissionSuccess').classList.remove('hidden');
      submitBtn.innerHTML = "✓ Submitted & Accredited!";
      submitBtn.classList.remove('bg-emerald-500', 'hover:bg-emerald-400');
      submitBtn.classList.add('bg-slate-700', 'text-slate-300');
      
      // Award certificate XP + Confetti
      addXp(150);
      if (window.confetti) {
        confetti({ particleCount: 100, spread: 100, origin: { y: 0.6 } });
      }
      lucide.createIcons();
    });

    // Slide Carousel Functions
    function renderSlide() {
      const slide = slides[currentSlide];
      document.getElementById('slideIndexLabel').innerText = `SLIDE ${currentSlide + 1} OF ${slides.length}`;

      const container = document.getElementById('slideContent');
      container.innerHTML = `
        <span class="text-xs uppercase font-bold text-amber-400 font-mono tracking-widest">${slide.tag}</span>
        <h3 class="text-xl sm:text-2xl font-black text-white font-heading">${slide.title}</h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto">${slide.desc}</p>
        <div class="pt-3 max-w-md mx-auto space-y-2 text-left text-xs text-slate-300">
          ${slide.bullets.map(b => `<div class="flex items-center gap-2"><i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400 shrink-0"></i><span>${b}</span></div>`).join('')}
        </div>
      `;

      // Render Dots
      const dotsContainer = document.getElementById('slideDots');
      dotsContainer.innerHTML = slides.map((_, i) => `
        <button onclick="goToSlide(${i})" class="w-2.5 h-2.5 rounded-full transition ${i === currentSlide ? 'bg-amber-400 scale-125' : 'bg-slate-700 hover:bg-slate-600'}"></button>
      `).join('');

      lucide.createIcons();
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      renderSlide();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + slides.length) % slides.length;
      renderSlide();
    }

    function goToSlide(i) {
      currentSlide = i;
      renderSlide();
    }

    // AI Speech Narration Simulation (using browser Web Speech API)
    function playSpeechNarration() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel(); // Stop ongoing
        const scriptText = "What if charging your smartphone didn't burn coal, but harnessed the fury of a rainforest river? In Sarawak, Borneo, that is reality. Massive dams like Bakun drop water down penstocks, powering seventy percent of the grid. Yet, reservoirs submerged ancestral lands. The future is hybrid floating solar and community micro-hydro.";
        const utterance = new SpeechSynthesisUtterance(scriptText);
        utterance.rate = 1.0;
        utterance.pitch = 1.0;
        window.speechSynthesis.speak(utterance);
        
        const btn = document.getElementById('voiceBtn');
        btn.innerHTML = `<i data-lucide="volume-x" class="w-4 h-4"></i> Speaking...`;
        utterance.onend = () => {
          btn.innerHTML = `<i data-lucide="volume-2" class="w-4 h-4"></i> Listen to AI Voice`;
          lucide.createIcons();
        };
        lucide.createIcons();
      } else {
        alert("Web Speech API is not supported in this browser. Please read the provided narration script!");
      }
    }
  </script>
