              <div>
                <div class="flex justify-between text-[10px] text-slate-400 mb-0.5"><span>Total Freeze</span><span>10%</span></div>
                <div class="w-full bg-slate-800 rounded-full h-1.5"><div class="bg-cyan-500 h-1.5 rounded-full" style="width: 10%"></div></div>
              </div>
            </div>

          </div>

        </div>
      </div>

