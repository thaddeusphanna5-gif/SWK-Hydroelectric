    <!-- ================= PAGE 2: PHYSICS LAB & DAM SIMULATOR ================= -->
    <section id="tab-physics" class="page-view hidden space-y-8">
      
      <div class="border-b border-slate-800 pb-4">
        <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest flex items-center gap-1.5">
          <i data-lucide="cpu" class="w-4 h-4"></i> Interactive Laboratory
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">The Hydro Turbine Simulator</h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          Adjust water height (Head) and river flow (Discharge) to see how physics dictates power generation and ecological stress in real time!
        </p>
      </div>

      <!-- Simulator Console -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 bg-slate-800/70 border border-slate-700 rounded-3xl p-6 sm:p-8">
        
        <!-- Controls Column -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-700/80 space-y-4">
            <h3 class="text-sm font-bold text-emerald-400 flex items-center gap-2">
              <i data-lucide="sliders" class="w-4 h-4"></i> Reservoir & Penstock Controls
            </h3>

            <!-- Slider 1: Head Height -->
            <div>
              <div class="flex justify-between text-xs font-medium mb-1.5">
                <span class="text-slate-300">Dam Height / Water Head ($H$):</span>
                <span id="headVal" class="text-cyan-400 font-mono font-bold">150 meters</span>
              </div>
              <input type="range" id="headSlider" min="20" max="220" value="150" class="w-full accent-cyan-400 bg-slate-700 h-2 rounded-lg cursor-pointer" oninput="calculateSimulator()">
              <div class="flex justify-between text-[10px] text-slate-500 mt-1">
                <span>20m (Run-of-River)</span>
                <span>205m (Bakun Scale)</span>
              </div>
            </div>

            <!-- Slider 2: Flow Rate -->
            <div>
              <div class="flex justify-between text-xs font-medium mb-1.5">
                <span class="text-slate-300">Discharge Flow Rate ($Q$):</span>
                <span id="flowVal" class="text-teal-400 font-mono font-bold">850 m³/s</span>
              </div>
              <input type="range" id="flowSlider" min="100" max="2000" step="50" value="850" class="w-full accent-teal-400 bg-slate-700 h-2 rounded-lg cursor-pointer" oninput="calculateSimulator()">
              <div class="flex justify-between text-[10px] text-slate-500 mt-1">
                <span>100 m³/s (Dry Monsoon)</span>
                <span>2,000 m³/s (Peak Monsoon)</span>
              </div>
            </div>

            <!-- Slider 3: Turbine Efficiency -->
            <div>
              <div class="flex justify-between text-xs font-medium mb-1.5">
                <span class="text-slate-300">Francis Turbine Efficiency ($\eta$):</span>
                <span id="effVal" class="text-emerald-400 font-mono font-bold">90%</span>
              </div>
              <input type="range" id="effSlider" min="70" max="95" value="90" class="w-full accent-emerald-400 bg-slate-700 h-2 rounded-lg cursor-pointer" oninput="calculateSimulator()">
            </div>
          </div>

          <!-- Formula Explainer -->
          <div class="p-4 bg-slate-900/60 rounded-2xl border border-slate-800 text-xs text-slate-300 space-y-2 font-mono">
            <div class="text-[11px] font-bold text-amber-400">The Hydroelectric Equation:</div>
            <div class="text-sm text-cyan-300 font-bold">$P = \eta \times \rho \times g \times Q \times H$</div>
            <p class="text-[11px] text-slate-400">
              Where $\rho = 1000\,\text{kg/m}^3$ (water density), $g = 9.81\,\text{m/s}^2$ (gravity), $Q$ is volume, and $H$ is the hydraulic head drop.
            </p>
          </div>
        </div>

        <!-- Output Gauges Column -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <div class="bg-slate-900 p-5 rounded-2xl border border-cyan-500/30 text-center relative overflow-hidden">
              <div class="text-[11px] font-bold text-cyan-400 uppercase tracking-widest">Electrical Power Output</div>
              <div id="simPower" class="text-3xl sm:text-4xl font-extrabold text-white my-2 font-mono">1,126 MW</div>
              <div id="homesPowered" class="text-xs text-slate-400">Powers ~1.41 Million Bornean Homes</div>
              <div class="mt-3 w-full bg-slate-800 rounded-full h-2">
                <div id="powerBar" class="bg-cyan-400 h-2 rounded-full transition-all" style="width: 47%"></div>
              </div>
            </div>

            <div class="bg-slate-900 p-5 rounded-2xl border border-amber-500/30 text-center relative overflow-hidden">
              <div class="text-[11px] font-bold text-amber-400 uppercase tracking-widest">Ecological Flooding Risk</div>
              <div id="simEcoRisk" class="text-2xl sm:text-3xl font-extrabold text-amber-400 my-2 font-heading">High Inundation</div>
              <div id="ecoDescription" class="text-xs text-slate-400">Submerges ~420 km² of dense tropical canopy</div>
              <div class="mt-3 w-full bg-slate-800 rounded-full h-2">
                <div id="ecoBar" class="bg-amber-400 h-2 rounded-full transition-all" style="width: 75%"></div>
              </div>
            </div>

          </div>

          <!-- Dynamic Visual Graphic -->
          <div class="bg-slate-900 rounded-2xl p-6 border border-slate-700/60 flex flex-col sm:flex-row items-center justify-around gap-6 text-center">
            <div class="space-y-1">
              <div class="text-3xl">🏔️ 💧</div>
              <div class="text-xs font-bold text-slate-200">High Altitude Reservoir</div>
              <div class="text-[10px] text-slate-400">Gravitational Potential ($E_p$)</div>
            </div>
            <i data-lucide="chevrons-right" class="w-6 h-6 text-emerald-400 hidden sm:block animate-pulse"></i>
            <div class="space-y-1">
              <div class="text-3xl">🌀 ⚙️</div>
              <div class="text-xs font-bold text-slate-200">Penstock & Runner Blades</div>
              <div class="text-[10px] text-slate-400">Kinetic & Mechanical ($E_k$)</div>
            </div>
            <i data-lucide="chevrons-right" class="w-6 h-6 text-emerald-400 hidden sm:block animate-pulse"></i>
            <div class="space-y-1">
              <div class="text-3xl">⚡ 💡</div>
              <div class="text-xs font-bold text-slate-200">Stator & Grid Lines</div>
              <div class="text-[10px] text-slate-400">Clean Alternating Current ($AC$)</div>
            </div>
          </div>

          <div class="text-right">
            <button onclick="awardBonusXP(50, 'Physics Mastery')" class="bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 border border-cyan-500/40 text-xs px-4 py-2 rounded-xl transition">
              + Claim 50 Lab Explorer XP
            </button>
          </div>
        </div>

